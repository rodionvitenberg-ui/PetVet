# === Django ===
SECRET_KEY=change-me
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1,careyour.pet,www.careyour.pet

# === Database (PostgreSQL) ===
DB_NAME=pet_db_vet
DB_USER=postgres
DB_PASSWORD=change-me
DB_HOST=db
DB_PORT=5432

# === Redis ===
REDIS_HOST=redis
REDIS_PORT=6379

# === Frontend URL (для ссылок активации) ===
FRONTEND_URL=http://localhost:3000

# === Demo login ===
ENABLE_DEMO_LOGIN=False

# === AI Assistant (DeepSeek) ===
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# === Subscription ($5/mo): Cryptomus (crypto) ===
CRYPTOMUS_MERCHANT_ID=
CRYPTOMUS_API_KEY=
CRYPTOMUS_AMOUNT=5
CRYPTOMUS_SUCCESS_URL=http://localhost:3000/profile?checkout=success
CRYPTOMUS_WEBHOOK_URL=http://localhost:8000/api/billing/subscription/webhook/cryptomus/

# === Email (SMTP) ===
# Если EMAIL_HOST_PASSWORD пустой — используется console backend
EMAIL_HOST_PASSWORD=
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=
DEFAULT_FROM_EMAIL=noreply@careyour.pet

# === Google OAuth ===
